        def Material "PurpleBody"
        {
            token outputs:surface.connect = </Object/Looks/PurpleBody/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.065, 0.025, 0.105)
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "PurpleLid"
        {
            token outputs:surface.connect = </Object/Looks/PurpleLid/Surface.outputs:surface>

